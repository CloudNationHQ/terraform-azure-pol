**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# lock files: reusable module, consumers lock in their own root module
.terraform.lock.hcl

# local variable / override / plan files
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*tfplan*

# CLI config
.terraformrc
terraform.rc

# go test artefacts (tests/)
tests/vendor/
